    <wasVerifiedBy>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/owl/owlapi/turtle#val_None">
        <rdf:type rdf:resource="http://example.org/cc#Validator"/>
        <agentName>No validator</agentName>
        <rdfs:label>No validator (project rejected)</rdfs:label>
      </owl:NamedIndividual>
    </wasVerifiedBy>
    <prov:used>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/owl/owlapi/turtle#proj_VCS1176">
        <rdf:type rdf:resource="http://example.org/cc#Project"/>
        <hasProjectID>VCS1176</hasProjectID>
        <hasProjectName>System of Root Intensification (SRI) programme</hasProjectName>
        <hasScope>Agriculture</hasScope>
        <hasCountry rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#India"/>
        <hasProjectStatus rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#RejectedByAdministrator"/>
        <hasProjectType>Rice Emission Reductions</hasProjectType>
        <hasRegion rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#SouthernAsia"/>
        <hasRegistry rdf:resource="http://example.org/cc#VCS"/>
        <rdfs:comment>Rejected project illustrating non-approved case in the taxonomy (status = Rejected by Administrator).</rdfs:comment>
        <rdfs:label>System of Root Intensification (SRI) programme: Reduction of Methane emissions and water consumption in rice fields of India</rdfs:label>
        <owl:differentFrom rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#proj_VCS1225"/>
        <hasDeveloper rdf:resource="http://www.semanticweb.org/owl/owlapi/turtle#dev_EmergentVenturesIndia"/>
      </owl:NamedIndividual>
    </prov:used>
    <rdfs:label>Attempted issuance for VCS1176 (rejected)</rdfs:label>
  </owl:NamedIndividual>
